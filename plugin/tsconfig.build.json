{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // The shared encoding module lives outside this package, so the common
    // source directory is the repo root. TS 7 requires that be explicit.
    "rootDir": "..",
    "types": [],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
